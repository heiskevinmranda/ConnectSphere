# Database (SQLite via libSQL). Relative to the project root at runtime
# and the Prisma config directory for the CLI - this value resolves to
# ./dev.db for both.
DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Auth
# NOTE: avoid "$" or "${...}" inside .env values - Next.js expands them
# as environment-variable references (e.g. "My$ecureJWT!" becomes "My!").
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-this-to-a-secure-random-string-of-quality

# Seed-time admin credentials. If unset, the seed generates strong random
# passwords and prints them to the console once.
ADMIN_EMAIL=admin@connectsphere.co.tz
ADMIN_PASSWORD=change-this-too
SUPER_ADMIN_EMAIL=superadmin@connectsphere.co.tz
SUPER_ADMIN_PASSWORD=change-this-too

# AzamPay
AZAMPAY_BASE_URL=https://sandbox.azampay.co.tz
AZAMPAY_APP_NAME=DASH
AZAMPAY_CLIENT_ID=your-client-id
AZAMPAY_CLIENT_SECRET=your-client-secret
AZAMPAY_API_KEY=your-api-key

# Router Management (REQUIRED before subscriber devices can connect;
# the connect endpoint fails closed when these are unset)
ROUTER_MAC_ADDRESS=00:1A:2B:3C:4D:5E
ROUTER_SERIAL_NUMBER=1234567890
ROUTER_IMEI=123456789012345

# Cron (REQUIRED to keep the /api/cron/expire-subscriptions endpoint shut)
CRON_SECRET=change-this-to-a-secure-random-string

# AzamPay payment webhook. MANDATORY in production - the endpoint refuses
# unsigned deliveries when this is set, and refuses to run at all without
# it in production builds.
WEBHOOK_SECRET=change-this-to-a-secure-random-string

# Rate limiting. Set to "true" ONLY when the app sits behind a trusted
# reverse proxy that overwrites X-Forwarded-For. Never trust it from
# arbitrary clients.
TRUST_PROXY=false